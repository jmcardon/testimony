# End-to-end test container for testimonyd.
#
# Uses an amd64 base so the prebuilt artifacts work on Apple Silicon hosts via
# Docker Desktop's emulation. We compile the workspace inside the container so
# we exercise the same toolchain everywhere.

FROM --platform=linux/amd64 rust:1.89-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        iproute2 \
        net-tools \
        procps \
        tcpdump \
        tcpreplay \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
# Copy workspace; build to a target dir we expose for caching.
COPY Cargo.toml /work/Cargo.toml
COPY crates /work/crates
RUN cargo build --release
# Build the perf harness too so the E2E can run it.
RUN cargo build --release -p testimony-client --bench recv_throughput
# Synthesise a large (~150 MB) deterministic pcap for the throughput
# benchmark. tcpreplay loops it forever during the timed window so the
# absolute size matters less than "big enough that the kernel doesn't
# notice it caching" — but a couple hundred MB of varied frames
# guarantees we measure receive throughput, not pcap-decode caching.
# `/work/tests` is created by the COPY lines below in this Dockerfile,
# but those run AFTER this RUN, so we mkdir -p it ourselves first.
RUN mkdir -p /work/tests && /work/target/release/gen_perf_pcap \
        --count 1500000 \
        --size 100 \
        --out /work/tests/perf.pcap

# Bring in the integration assets too, so a single container can run them.
COPY tests/run_e2e.sh /work/tests/run_e2e.sh
COPY tests/random_shutdown.sh /work/tests/random_shutdown.sh
COPY tests/perf_c_vs_rust.sh /work/tests/perf_c_vs_rust.sh
COPY tests/test.pcap /work/tests/test.pcap
COPY tests/c_abi_smoke.c /work/tests/c_abi_smoke.c
# Byte-for-byte golden output kept in sync with `integration_test/test.expected`
# (a copy lives in this build context too because Docker COPY can't escape).
# This is the Go-era assertion that proves packet-data slicing matches the
# legacy daemon — catches off-by-one in tp_mac, snaplen, or PacketIter.
COPY tests/test.expected /work/tests/test.expected
# Vendored C sources for the perf comparison: the legacy C client is the
# baseline we're benchmarking the Rust port against. Kept in
# rust/tests/c/ because Docker COPY can't escape the build context — the
# canonical source is c/ at the repo root.
COPY tests/c /work/c
RUN chmod +x /work/tests/run_e2e.sh /work/tests/random_shutdown.sh /work/tests/perf_c_vs_rust.sh

# Pre-compile the C ABI smoke test against the just-built libtestimony.so.
RUN cc /work/tests/c_abi_smoke.c \
       -L /work/target/release -ltestimony \
       -Wl,-rpath,/work/target/release \
       -o /work/tests/c_abi_smoke
# Pre-compile the C testclient (used by perf_c_vs_rust.sh).
RUN cc -O2 /work/c/testimony_client.c \
       -I /work/c \
       -L /work/target/release -ltestimony \
       -Wl,-rpath,/work/target/release \
       -o /tmp/testimony_c_client

ENTRYPOINT ["/work/tests/run_e2e.sh"]
